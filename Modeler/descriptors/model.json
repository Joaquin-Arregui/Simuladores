{
  "name": "modelExtension",
  "prefix": "model",
  "uri": "http://model",
  "xml": {
    "tagAlias": "lowerCase"
  },
  "types": [
    {
      "name": "CustomProcess",
      "extends": ["bpmn:Process"],
      "properties": [
        {
          "name": "instance",
          "isAttr": true,
          "type": "String"
        },
        {
          "name": "frequency",
          "isAttr": true,
          "type": "Real"
        },
        {
          "name": "seed",
          "isAttr": true,
          "type": "String"
        },
        {
          "name": "userWithoutRole",
          "isAttr": false,
          "isMany": true,
          "type": "String"
        },
        {
          "name": "userWithRole",
          "isAttr": false,
          "isMany": true,
          "type": "KeyValuePair"
        }
      ]
    },
    {
      "name": "KeyValuePair",
      "superClass": [ "Element" ],
      "meta": { "allowedIn": [ "bpmn:Process" ] },
      "properties": [
        {
          "name": "key",
          "type": "String"
        },
        {
          "name": "value",
          "type": "String"
        }
      ]
    },
    {
      "name": "UserWithoutRole",
      "superClass": [ "Element" ],
      "meta": { "allowedIn": [ "bpmn:Process" ] },
      "properties": [
        {
          "name": "value",
          "type": "String",
          "isBody": true
        }
      ]
    }
  ]
}
