<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:model="http://model" xmlns:user="http://user" id="Definitions_smoke" targetNamespace="http://bpmn.io/schema/bpmn">
  <bpmn:process id="Process_smoke" name="Smoke process" isExecutable="false" model:instance="3" model:frequency="2">
    <model:userWithoutRole>Ana</model:userWithoutRole>
    <model:userWithRole><model:key>reviewer</model:key><model:value>Ana,Luis</model:value></model:userWithRole>
    <bpmn:startEvent id="Start_smoke"><bpmn:outgoing>Flow_start</bpmn:outgoing></bpmn:startEvent>
    <bpmn:userTask id="Task_smoke" name="Review request" user:NumberOfExecutions="2" user:minimumTime="2" user:maximumTime="9">
      <bpmn:incoming>Flow_start</bpmn:incoming><bpmn:outgoing>Flow_end</bpmn:outgoing>
      <user:UserTask>Ana</user:UserTask>
    </bpmn:userTask>
    <bpmn:endEvent id="End_smoke"><bpmn:incoming>Flow_end</bpmn:incoming></bpmn:endEvent>
    <bpmn:sequenceFlow id="Flow_start" sourceRef="Start_smoke" targetRef="Task_smoke" />
    <bpmn:sequenceFlow id="Flow_end" sourceRef="Task_smoke" targetRef="End_smoke" />
  </bpmn:process>
  <bpmndi:BPMNDiagram id="Diagram_smoke">
    <bpmndi:BPMNPlane id="Plane_smoke" bpmnElement="Process_smoke">
      <bpmndi:BPMNShape id="Start_smoke_di" bpmnElement="Start_smoke"><dc:Bounds x="180" y="142" width="36" height="36" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_smoke_di" bpmnElement="Task_smoke"><dc:Bounds x="280" y="120" width="100" height="80" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="End_smoke_di" bpmnElement="End_smoke"><dc:Bounds x="444" y="142" width="36" height="36" /></bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="Flow_start_di" bpmnElement="Flow_start"><di:waypoint x="216" y="160" /><di:waypoint x="280" y="160" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_end_di" bpmnElement="Flow_end"><di:waypoint x="380" y="160" /><di:waypoint x="444" y="160" /></bpmndi:BPMNEdge>
    </bpmndi:BPMNPlane>
  </bpmndi:BPMNDiagram>
</bpmn:definitions>
