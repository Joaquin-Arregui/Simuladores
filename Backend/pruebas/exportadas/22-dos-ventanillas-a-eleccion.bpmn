      </bpmn:extensionElements>
      <bpmn:incoming>o1</bpmn:incoming>
      <bpmn:outgoing>o2</bpmn:outgoing>
      <bpmn:multiInstanceLoopCharacteristics />
    </bpmn:sendTask>
    <bpmn:parallelGateway id="Bifurca_O" name="Abrir las dos ventanillas">
      <bpmn:incoming>o2</bpmn:incoming>
      <bpmn:outgoing>o3</bpmn:outgoing>
      <bpmn:outgoing>o4</bpmn:outgoing>
    </bpmn:parallelGateway>
    <bpmn:receiveTask id="Recoger_A" name="Recoger en la ventanilla A" user:NumberOfExecutions="1" user:minimumTime="1" user:maximumTime="1">
      <bpmn:extensionElements>
