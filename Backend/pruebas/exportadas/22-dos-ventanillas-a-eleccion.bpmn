    <bpmn:participant id="Pool_Orquestado" name="Orquestado" processRef="Process_Pool_Orquestado" participantWithoutLane:frequency="3" participantWithoutLane:instances="6" participantWithoutLane:orchestrationRole="orchestrated" participantWithoutLane:infiniteResources="true">
