  <bpmn:collaboration id="Colaboracion" name="Proceso base" collab:instance="1">
    <bpmn:participant id="Pool_SACU" name="SACU" processRef="Process_Pool_SACU" participantWithoutLane:frequency="0" participantWithoutLane:instances="1" participantWithoutLane:orchestrationRole="orchestrator">
      <bpmn:extensionElements>
        <participantWithoutLane:userWithoutRole>Ana</participantWithoutLane:userWithoutRole>
        <participantWithoutLane:userWithoutRole>Bea</participantWithoutLane:userWithoutRole>
        <participantWithoutLane:userWithoutRole>Carlos</participantWithoutLane:userWithoutRole>
      </bpmn:extensionElements>
      <bpmn:participantMultiplicity />
    </bpmn:participant>
    <bpmn:participant id="Pool_Residente" name="Residente" processRef="Process_Pool_Residente" participantWithoutLane:frequency="0" participantWithoutLane:instances="100" participantWithoutLane:orchestrationRole="orchestrated" participantWithoutLane:infiniteResources="true" participantWithoutLane:arrivalMode="uniform" participantWithoutLane:arrivalWindow="120">
      <bpmn:extensionElements>
        <participantWithoutLane:userWithoutRole>Residente</participantWithoutLane:userWithoutRole>
      </bpmn:extensionElements>
      <bpmn:participantMultiplicity />
    </bpmn:participant>
    <bpmn:messageFlow id="Solicitud" name="Solicitud" sourceRef="Enviar_Solicitud" targetRef="Recibir_Solicitudes" />
