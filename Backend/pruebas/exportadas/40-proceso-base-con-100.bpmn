    <bpmn:exclusiveGateway id="Aceptada" name="Aceptada?">
      <bpmn:incoming>r4</bpmn:incoming>
      <bpmn:outgoing>r5</bpmn:outgoing>
      <bpmn:outgoing>r6</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:exclusiveGateway id="Decide_Reclamar" name="Reclamar?">
      <bpmn:incoming>r6</bpmn:incoming>
      <bpmn:outgoing>r7</bpmn:outgoing>
      <bpmn:outgoing>r8</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:sendTask id="Reclamar" name="Presentar una reclamacion" user:NumberOfExecutions="1" user:minimumTime="5" user:maximumTime="15">
      <bpmn:extensionElements>
