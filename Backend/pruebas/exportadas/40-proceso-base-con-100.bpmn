    </bpmn:receiveTask>
    <bpmn:endEvent id="Fin_Aceptada" name="Aceptada">
      <bpmn:incoming>r5</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:endEvent id="Fin_Rechazada" name="Rechazada sin reclamar">
      <bpmn:incoming>r8</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:endEvent id="Fin_Reclamada" name="Reevaluada">
      <bpmn:incoming>r10</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="r1" sourceRef="Ini_R" targetRef="Rellenar_Formulario" />
    <bpmn:sequenceFlow id="r2" sourceRef="Rellenar_Formulario" targetRef="Enviar_Solicitud" />
    <bpmn:sequenceFlow id="r3" sourceRef="Enviar_Solicitud" targetRef="Esperar_Resultado" />
    <bpmn:sequenceFlow id="r4" sourceRef="Esperar_Resultado" targetRef="Aceptada" />
    <bpmn:sequenceFlow id="r5" name="Si" sourceRef="Aceptada" targetRef="Fin_Aceptada" sequenceFlow:percentageOfBranches="60" />
    <bpmn:sequenceFlow id="r6" name="No" sourceRef="Aceptada" targetRef="Decide_Reclamar" sequenceFlow:percentageOfBranches="40" />
    <bpmn:sequenceFlow id="r7" name="Si" sourceRef="Decide_Reclamar" targetRef="Reclamar" sequenceFlow:percentageOfBranches="50" />
    <bpmn:sequenceFlow id="r8" name="No" sourceRef="Decide_Reclamar" targetRef="Fin_Rechazada" sequenceFlow:percentageOfBranches="50" />
    <bpmn:sequenceFlow id="r9" sourceRef="Reclamar" targetRef="Esperar_Reevaluacion" />
