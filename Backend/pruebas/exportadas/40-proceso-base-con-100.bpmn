    <bpmn:messageFlow id="Reevaluacion" name="Reevaluacion" sourceRef="Enviar_Reevaluaciones" targetRef="Esperar_Reevaluacion" />
  </bpmn:collaboration>
  <bpmn:process id="Process_Pool_SACU" isExecutable="false">
    <bpmn:startEvent id="Ini_S" name="Abre la convocatoria">
      <bpmn:outgoing>s1</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:task id="Publicar_Convocatoria" name="Publicar la convocatoria" user:NumberOfExecutions="1" user:minimumTime="10" user:maximumTime="10">
      <bpmn:extensionElements>
        <user:userTask>Ana</user:userTask>
        <user:userTask>Bea</user:userTask>
        <user:userTask>Carlos</user:userTask>
      </bpmn:extensionElements>
      <bpmn:incoming>s1</bpmn:incoming>
      <bpmn:outgoing>s2</bpmn:outgoing>
    </bpmn:task>
    <bpmn:receiveTask id="Recibir_Solicitudes" name="Recibir una solicitud" user:NumberOfExecutions="1" user:minimumTime="1" user:maximumTime="1">
      <bpmn:extensionElements>
        <user:userTask>Ana</user:userTask>
        <user:userTask>Bea</user:userTask>
        <user:userTask>Carlos</user:userTask>
      </bpmn:extensionElements>
      <bpmn:incoming>s2</bpmn:incoming>
      <bpmn:outgoing>s3</bpmn:outgoing>
      <bpmn:multiInstanceLoopCharacteristics />
    </bpmn:receiveTask>
    <bpmn:task id="Evaluar_Propuestas" name="Evaluar una propuesta" user:NumberOfExecutions="1" user:minimumTime="20" user:maximumTime="60">
      <bpmn:extensionElements>
        <user:userTask>Ana</user:userTask>
        <user:userTask>Bea</user:userTask>
        <user:userTask>Carlos</user:userTask>
      </bpmn:extensionElements>
      <bpmn:incoming>s3</bpmn:incoming>
      <bpmn:outgoing>s4</bpmn:outgoing>
      <bpmn:multiInstanceLoopCharacteristics />
    </bpmn:task>
    <bpmn:task id="Publicar_Aceptados" name="Publicar la lista de aceptados" user:NumberOfExecutions="1" user:minimumTime="10" user:maximumTime="10">
      <bpmn:extensionElements>
        <user:userTask>Ana</user:userTask>
        <user:userTask>Bea</user:userTask>
        <user:userTask>Carlos</user:userTask>
      </bpmn:extensionElements>
      <bpmn:incoming>s4</bpmn:incoming>
      <bpmn:outgoing>s5</bpmn:outgoing>
    </bpmn:task>
    <bpmn:sendTask id="Enviar_Resultados" name="Enviar un resultado" user:NumberOfExecutions="1" user:minimumTime="1" user:maximumTime="2">
      <bpmn:extensionElements>
        <user:userTask>Ana</user:userTask>
        <user:userTask>Bea</user:userTask>
        <user:userTask>Carlos</user:userTask>
      </bpmn:extensionElements>
      <bpmn:incoming>s5</bpmn:incoming>
      <bpmn:outgoing>s6</bpmn:outgoing>
      <bpmn:multiInstanceLoopCharacteristics />
    </bpmn:sendTask>
    <bpmn:receiveTask id="Recibir_Reclamaciones" name="Recibir una reclamacion" user:NumberOfExecutions="1" user:minimumTime="1" user:maximumTime="1">
      <bpmn:extensionElements>
        <user:userTask>Ana</user:userTask>
        <user:userTask>Bea</user:userTask>
        <user:userTask>Carlos</user:userTask>
      </bpmn:extensionElements>
      <bpmn:incoming>s6</bpmn:incoming>
      <bpmn:outgoing>s7</bpmn:outgoing>
      <bpmn:multiInstanceLoopCharacteristics />
    </bpmn:receiveTask>
    <bpmn:task id="Evaluar_Reclamaciones" name="Evaluar una reclamacion" user:NumberOfExecutions="1" user:minimumTime="20" user:maximumTime="40">
      <bpmn:extensionElements>
        <user:userTask>Ana</user:userTask>
        <user:userTask>Bea</user:userTask>
        <user:userTask>Carlos</user:userTask>
      </bpmn:extensionElements>
      <bpmn:incoming>s7</bpmn:incoming>
      <bpmn:outgoing>s8</bpmn:outgoing>
      <bpmn:multiInstanceLoopCharacteristics />
    </bpmn:task>
    <bpmn:sendTask id="Enviar_Reevaluaciones" name="Enviar una reevaluacion" user:NumberOfExecutions="1" user:minimumTime="1" user:maximumTime="2">
      <bpmn:extensionElements>
        <user:userTask>Ana</user:userTask>
        <user:userTask>Bea</user:userTask>
        <user:userTask>Carlos</user:userTask>
      </bpmn:extensionElements>
      <bpmn:incoming>s8</bpmn:incoming>
      <bpmn:outgoing>s9</bpmn:outgoing>
      <bpmn:multiInstanceLoopCharacteristics />
    </bpmn:sendTask>
    <bpmn:endEvent id="Fin_S" name="Cierra la convocatoria">
