<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:model="http://model" xmlns:sequenceFlow="http://sequenceFlow" xmlns:user="http://user" id="Definitions_13_ciclo_de_flujos" targetNamespace="http://bpmn.io/schema/bpmn" exporter="my-bpmn-exporter" exporterVersion="1.0.0">
  <bpmn:process id="Proceso" name="Reintento" isExecutable="false" model:instance="2" model:frequency="30">
    <bpmn:extensionElements>
      <model:userWithoutRole>Ana</model:userWithoutRole>
    </bpmn:extensionElements>
    <bpmn:startEvent id="Ini" name="Entra el expediente">
      <bpmn:outgoing>f1</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:task id="Trabajar" name="Trabajar el expediente" user:NumberOfExecutions="1" user:minimumTime="10" user:maximumTime="20">
      <bpmn:extensionElements>
        <user:userTask>Ana</user:userTask>
      </bpmn:extensionElements>
      <bpmn:incoming>f1</bpmn:incoming>
      <bpmn:incoming>f3</bpmn:incoming>
      <bpmn:outgoing>f2</bpmn:outgoing>
    </bpmn:task>
    <bpmn:exclusiveGateway id="Decidir" name="Vale o se repite">
      <bpmn:incoming>f2</bpmn:incoming>
      <bpmn:outgoing>f3</bpmn:outgoing>
      <bpmn:outgoing>f4</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:endEvent id="Fin" name="Expediente cerrado">
      <bpmn:incoming>f4</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="f1" sourceRef="Ini" targetRef="Trabajar" />
    <bpmn:sequenceFlow id="f2" sourceRef="Trabajar" targetRef="Decidir" />
    <bpmn:sequenceFlow id="f3" sourceRef="Decidir" targetRef="Trabajar" sequenceFlow:percentageOfBranches="40" />
    <bpmn:sequenceFlow id="f4" sourceRef="Decidir" targetRef="Fin" sequenceFlow:percentageOfBranches="60" />
  </bpmn:process>
  <bpmndi:BPMNDiagram id="BPMNDiagram_1">
    <bpmndi:BPMNPlane id="BPMNPlane_1" bpmnElement="Proceso">
      <bpmndi:BPMNShape id="Ini_di" bpmnElement="Ini">
        <dc:Bounds x="272" y="122" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Trabajar_di" bpmnElement="Trabajar">
        <dc:Bounds x="410" y="100" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Decidir_di" bpmnElement="Decidir" isMarkerVisible="true">
        <dc:Bounds x="605" y="115" width="50" height="50" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Fin_di" bpmnElement="Fin">
        <dc:Bounds x="782" y="122" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="f1_di" bpmnElement="f1">
        <di:waypoint x="290" y="140" />
        <di:waypoint x="460" y="140" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="f2_di" bpmnElement="f2">
        <di:waypoint x="460" y="140" />
        <di:waypoint x="630" y="140" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="f3_di" bpmnElement="f3">
        <di:waypoint x="630" y="140" />
        <di:waypoint x="460" y="140" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="f4_di" bpmnElement="f4">
        <di:waypoint x="630" y="140" />
        <di:waypoint x="800" y="140" />
      </bpmndi:BPMNEdge>
    </bpmndi:BPMNPlane>
  </bpmndi:BPMNDiagram>
</bpmn:definitions>
