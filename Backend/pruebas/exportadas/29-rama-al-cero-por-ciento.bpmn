<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:collab="http://collaboration" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:participantWithoutLane="http://participantWithoutLane" xmlns:sequenceFlow="http://sequenceFlow" xmlns:user="http://user" id="Definitions_29_rama_al_cero_por_ciento" targetNamespace="http://bpmn.io/schema/bpmn" exporter="my-bpmn-exporter" exporterVersion="1.0.0">
  <bpmn:collaboration id="Colaboracion" name="Rama al cero por ciento" collab:instance="1">
    <bpmn:participant id="Pool_Orquestador" name="Orquestador" processRef="Process_Pool_Orquestador" participantWithoutLane:frequency="0" participantWithoutLane:instances="1" participantWithoutLane:orchestrationRole="orchestrator" participantWithoutLane:infiniteResources="true">
      <bpmn:extensionElements>
        <participantWithoutLane:userWithoutRole>Ana</participantWithoutLane:userWithoutRole>
      </bpmn:extensionElements>
      <bpmn:participantMultiplicity />
    </bpmn:participant>
    <bpmn:participant id="Pool_Orquestado" name="Orquestado" processRef="Process_Pool_Orquestado" participantWithoutLane:frequency="0" participantWithoutLane:instances="2" participantWithoutLane:orchestrationRole="orchestrated" participantWithoutLane:infiniteResources="true">
      <bpmn:extensionElements>
        <participantWithoutLane:userWithoutRole>Beto</participantWithoutLane:userWithoutRole>
      </bpmn:extensionElements>
      <bpmn:participantMultiplicity />
    </bpmn:participant>
    <bpmn:messageFlow id="Solicitud" name="Solicitud" sourceRef="Solicitar" targetRef="Recoger" />
  </bpmn:collaboration>
  <bpmn:process id="Process_Pool_Orquestador" isExecutable="false">
    <bpmn:startEvent id="Ini_O" name="Abre la convocatoria">
      <bpmn:outgoing>o1</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:parallelGateway id="Bifurca_O" name="Revisar y montar el tribunal">
      <bpmn:incoming>o1</bpmn:incoming>
      <bpmn:outgoing>o2</bpmn:outgoing>
      <bpmn:outgoing>o3</bpmn:outgoing>
    </bpmn:parallelGateway>
    <bpmn:task id="Revisar" name="Revisar las bases" user:NumberOfExecutions="1" user:minimumTime="5" user:maximumTime="5">
      <bpmn:extensionElements>
        <user:userTask>Ana</user:userTask>
      </bpmn:extensionElements>
      <bpmn:incoming>o2</bpmn:incoming>
      <bpmn:outgoing>o4</bpmn:outgoing>
    </bpmn:task>
    <bpmn:exclusiveGateway id="Elige_O" name="Recoger o rehacer el tribunal">
      <bpmn:incoming>o4</bpmn:incoming>
      <bpmn:outgoing>o5</bpmn:outgoing>
      <bpmn:outgoing>o6</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:receiveTask id="Recoger" name="Recoger una solicitud" user:NumberOfExecutions="1" user:minimumTime="1" user:maximumTime="1">
      <bpmn:extensionElements>
        <user:userTask>Ana</user:userTask>
      </bpmn:extensionElements>
      <bpmn:incoming>o5</bpmn:incoming>
      <bpmn:outgoing>o7</bpmn:outgoing>
      <bpmn:multiInstanceLoopCharacteristics />
    </bpmn:receiveTask>
    <bpmn:task id="Tribunal" name="Montar el tribunal" user:NumberOfExecutions="1" user:minimumTime="1" user:maximumTime="1">
      <bpmn:extensionElements>
        <user:userTask>Ana</user:userTask>
      </bpmn:extensionElements>
      <bpmn:incoming>o3</bpmn:incoming>
      <bpmn:incoming>o6</bpmn:incoming>
      <bpmn:outgoing>o8</bpmn:outgoing>
    </bpmn:task>
    <bpmn:inclusiveGateway id="Une_O" name="Esperar a las dos">
      <bpmn:incoming>o7</bpmn:incoming>
      <bpmn:incoming>o8</bpmn:incoming>
      <bpmn:outgoing>o9</bpmn:outgoing>
    </bpmn:inclusiveGateway>
    <bpmn:task id="Evaluar" name="Evaluar una solicitud" user:NumberOfExecutions="1" user:minimumTime="5" user:maximumTime="5">
      <bpmn:extensionElements>
        <user:userTask>Ana</user:userTask>
      </bpmn:extensionElements>
      <bpmn:incoming>o9</bpmn:incoming>
      <bpmn:outgoing>o10</bpmn:outgoing>
      <bpmn:multiInstanceLoopCharacteristics />
    </bpmn:task>
    <bpmn:endEvent id="Fin_O" name="Cierra la convocatoria">
      <bpmn:incoming>o10</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="o1" sourceRef="Ini_O" targetRef="Bifurca_O" />
    <bpmn:sequenceFlow id="o2" sourceRef="Bifurca_O" targetRef="Revisar" />
    <bpmn:sequenceFlow id="o3" sourceRef="Bifurca_O" targetRef="Tribunal" />
    <bpmn:sequenceFlow id="o4" sourceRef="Revisar" targetRef="Elige_O" />
    <bpmn:sequenceFlow id="o5" name="Recoger" sourceRef="Elige_O" targetRef="Recoger" sequenceFlow:percentageOfBranches="100" />
    <bpmn:sequenceFlow id="o6" name="Rehacer el tribunal" sourceRef="Elige_O" targetRef="Tribunal" sequenceFlow:percentageOfBranches="0" />
    <bpmn:sequenceFlow id="o7" sourceRef="Recoger" targetRef="Une_O" />
    <bpmn:sequenceFlow id="o8" sourceRef="Tribunal" targetRef="Une_O" />
    <bpmn:sequenceFlow id="o9" sourceRef="Une_O" targetRef="Evaluar" />
    <bpmn:sequenceFlow id="o10" sourceRef="Evaluar" targetRef="Fin_O" />
  </bpmn:process>
  <bpmn:process id="Process_Pool_Orquestado" isExecutable="false">
    <bpmn:startEvent id="Ini_R" name="Entra el solicitante">
      <bpmn:outgoing>r1</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:sendTask id="Solicitar" name="Enviar la solicitud" user:NumberOfExecutions="1" user:minimumTime="10" user:maximumTime="10">
      <bpmn:extensionElements>
        <user:userTask>Beto</user:userTask>
      </bpmn:extensionElements>
      <bpmn:incoming>r1</bpmn:incoming>
      <bpmn:outgoing>r2</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:endEvent id="Fin_R" name="Fin del solicitante">
      <bpmn:incoming>r2</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="r1" sourceRef="Ini_R" targetRef="Solicitar" />
    <bpmn:sequenceFlow id="r2" sourceRef="Solicitar" targetRef="Fin_R" />
  </bpmn:process>
