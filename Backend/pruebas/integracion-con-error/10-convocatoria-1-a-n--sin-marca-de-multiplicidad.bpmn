<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:collab="http://collaboration" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:participantWithoutLane="http://participantWithoutLane" xmlns:user="http://user" id="Definitions_10_convocatoria_1_a_n" targetNamespace="http://bpmn.io/schema/bpmn" exporter="my-bpmn-exporter" exporterVersion="1.0.0">
  <bpmn:collaboration id="Colaboracion" collab:instance="1">
    <bpmn:participant id="Pool_Orquestador" name="Orquestador" processRef="Process_Pool_Orquestador" participantWithoutLane:frequency="0">
      <participantWithoutLane:userWithoutRole>Ana</participantWithoutLane:userWithoutRole>
      <bpmn:participantMultiplicity />
    </bpmn:participant>
    <bpmn:participant id="Pool_Orquestado" name="Orquestado" processRef="Process_Pool_Orquestado" participantWithoutLane:frequency="15">
      <participantWithoutLane:userWithoutRole>Beto</participantWithoutLane:userWithoutRole>
    </bpmn:participant>
    <bpmn:messageFlow id="Convocatoria" name="Convocatoria" sourceRef="Convocar" targetRef="Esperar_Convocatoria" />
    <bpmn:messageFlow id="Solicitud" name="Solicitud" sourceRef="Solicitar" targetRef="Recoger" />
    <bpmn:messageFlow id="Resultado" name="Resultado" sourceRef="Responder" targetRef="Esperar_Resultado" />
  </bpmn:collaboration>
  <bpmn:process id="Process_Pool_Orquestador" isExecutable="false">
    <bpmn:startEvent id="Ini_O" name="Abre la convocatoria">
      <bpmn:outgoing>o1</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:sendTask id="Convocar" name="Publicar la convocatoria" user:NumberOfExecutions="4" user:minimumTime="2" user:maximumTime="2">
      <user:UserTask>Ana</user:UserTask>
      <bpmn:incoming>o1</bpmn:incoming>
      <bpmn:outgoing>o2</bpmn:outgoing>
      <bpmn:multiInstanceLoopCharacteristics />
    </bpmn:sendTask>
    <bpmn:receiveTask id="Recoger" name="Recoger una solicitud" user:NumberOfExecutions="4" user:minimumTime="5" user:maximumTime="5">
      <user:UserTask>Ana</user:UserTask>
      <bpmn:incoming>o2</bpmn:incoming>
      <bpmn:outgoing>o3</bpmn:outgoing>
      <bpmn:multiInstanceLoopCharacteristics />
    </bpmn:receiveTask>
    <bpmn:sendTask id="Responder" name="Responder a una solicitud" user:NumberOfExecutions="4" user:minimumTime="3" user:maximumTime="3">
      <user:UserTask>Ana</user:UserTask>
      <bpmn:incoming>o3</bpmn:incoming>
      <bpmn:outgoing>o4</bpmn:outgoing>
      <bpmn:multiInstanceLoopCharacteristics />
    </bpmn:sendTask>
    <bpmn:endEvent id="Fin_O" name="Cierra la convocatoria">
      <bpmn:incoming>o4</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="o1" sourceRef="Ini_O" targetRef="Convocar" />
    <bpmn:sequenceFlow id="o2" sourceRef="Convocar" targetRef="Recoger" />
    <bpmn:sequenceFlow id="o3" sourceRef="Recoger" targetRef="Responder" />
    <bpmn:sequenceFlow id="o4" sourceRef="Responder" targetRef="Fin_O" />
  </bpmn:process>
  <bpmn:process id="Process_Pool_Orquestado" isExecutable="false">
    <bpmn:startEvent id="Ini_R" name="Entra el solicitante">
      <bpmn:outgoing>r1</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:receiveTask id="Esperar_Convocatoria" name="Esperar la convocatoria" user:NumberOfExecutions="1" user:minimumTime="2" user:maximumTime="2">
      <user:UserTask>Beto</user:UserTask>
      <bpmn:incoming>r1</bpmn:incoming>
      <bpmn:outgoing>r2</bpmn:outgoing>
    </bpmn:receiveTask>
    <bpmn:sendTask id="Solicitar" name="Enviar la solicitud" user:NumberOfExecutions="1" user:minimumTime="4" user:maximumTime="4">
      <user:UserTask>Beto</user:UserTask>
      <bpmn:incoming>r2</bpmn:incoming>
      <bpmn:outgoing>r3</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:receiveTask id="Esperar_Resultado" name="Esperar el resultado" user:NumberOfExecutions="1" user:minimumTime="2" user:maximumTime="2">
      <user:UserTask>Beto</user:UserTask>
      <bpmn:incoming>r3</bpmn:incoming>
      <bpmn:outgoing>r4</bpmn:outgoing>
    </bpmn:receiveTask>
    <bpmn:endEvent id="Fin_R" name="Fin del solicitante">
      <bpmn:incoming>r4</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="r1" sourceRef="Ini_R" targetRef="Esperar_Convocatoria" />
    <bpmn:sequenceFlow id="r2" sourceRef="Esperar_Convocatoria" targetRef="Solicitar" />
    <bpmn:sequenceFlow id="r3" sourceRef="Solicitar" targetRef="Esperar_Resultado" />
    <bpmn:sequenceFlow id="r4" sourceRef="Esperar_Resultado" targetRef="Fin_R" />
  </bpmn:process>
  <bpmndi:BPMNDiagram id="BPMNDiagram_1">
    <bpmndi:BPMNPlane id="BPMNPlane_1" bpmnElement="Colaboracion">
      <bpmndi:BPMNShape id="Pool_Orquestador_di" bpmnElement="Pool_Orquestador" isHorizontal="true">
        <dc:Bounds x="160" y="80" width="970" height="150" />
