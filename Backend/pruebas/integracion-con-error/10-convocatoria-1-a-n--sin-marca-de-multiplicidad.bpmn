      <bpmndi:BPMNShape id="Esperar_Convocatoria_di" bpmnElement="Esperar_Convocatoria">
        <dc:Bounds x="410" y="310" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Solicitar_di" bpmnElement="Solicitar">
        <dc:Bounds x="580" y="310" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Esperar_Resultado_di" bpmnElement="Esperar_Resultado">
        <dc:Bounds x="750" y="310" width="100" height="80" />
