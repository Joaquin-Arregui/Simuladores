<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:collab="http://collaboration" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:participantWithoutLane="http://participantWithoutLane" xmlns:user="http://user" id="Definitions_02_colaboracion" targetNamespace="http://bpmn.io/schema/bpmn" exporter="my-bpmn-exporter" exporterVersion="1.0.0">
  <bpmn:collaboration id="Colaboracion" collab:instance="3">
    <bpmn:participant id="Pool_Cliente" name="Cliente" processRef="Process_Pool_Cliente" participantWithoutLane:frequency="40">
      <participantWithoutLane:userWithoutRole>Carla</participantWithoutLane:userWithoutRole>
    </bpmn:participant>
    <bpmn:participant id="Pool_Servicio" name="Servicio" processRef="Process_Pool_Servicio" participantWithoutLane:frequency="0">
      <participantWithoutLane:userWithoutRole>Sara</participantWithoutLane:userWithoutRole>
      <participantWithoutLane:userWithoutRole>Diego</participantWithoutLane:userWithoutRole>
    </bpmn:participant>
    <bpmn:messageFlow id="Mensaje_Peticion" name="Peticion" sourceRef="Enviar_Peticion" targetRef="Recibir_Peticion" />
    <bpmn:messageFlow id="Mensaje_Respuesta" name="Respuesta" sourceRef="Enviar_Respuesta" targetRef="Esperar_Respuesta" />
  </bpmn:collaboration>
  <bpmn:process id="Process_Pool_Cliente" isExecutable="false">
    <bpmn:startEvent id="Inicio_C" name="Arranca el cliente">
      <bpmn:outgoing>Flujo_C1</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:sendTask id="Enviar_Peticion" name="Enviar la peticion" user:NumberOfExecutions="1" user:minimumTime="10" user:maximumTime="20">
      <user:UserTask>Carla</user:UserTask>
      <bpmn:incoming>Flujo_C1</bpmn:incoming>
      <bpmn:outgoing>Flujo_C2</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:receiveTask id="Esperar_Respuesta" name="Esperar la respuesta" user:NumberOfExecutions="1" user:minimumTime="5" user:maximumTime="10">
      <user:UserTask>Carla</user:UserTask>
      <bpmn:incoming>Flujo_C2</bpmn:incoming>
      <bpmn:outgoing>Flujo_C3</bpmn:outgoing>
    </bpmn:receiveTask>
    <bpmn:endEvent id="Fin_C" name="Fin del cliente">
      <bpmn:incoming>Flujo_C3</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="Flujo_C1" sourceRef="Inicio_C" targetRef="Enviar_Peticion" />
    <bpmn:sequenceFlow id="Flujo_C2" sourceRef="Enviar_Peticion" targetRef="Esperar_Respuesta" />
    <bpmn:sequenceFlow id="Flujo_C3" sourceRef="Esperar_Respuesta" targetRef="Fin_C" />
  </bpmn:process>
  