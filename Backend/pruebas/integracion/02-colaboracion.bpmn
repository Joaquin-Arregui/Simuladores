<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:collab="http://collaboration" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:participantWithoutLane="http://participantWithoutLane" xmlns:user="http://user" id="Definitions_02_colaboracion" targetNamespace="http://bpmn.io/schema/bpmn" exporter="my-bpmn-exporter" exporterVersion="1.0.0">
  <bpmn:collaboration id="Colaboracion" collab:instance="3">
    <bpmn:participant id="Pool_Cliente" name="Cliente" processRef="Process_Pool_Cliente" participantWithoutLane:frequency="40">
      <bpmn:extensionElements>
        <participantWithoutLane:userWithoutRole>Carla</participantWithoutLane:userWithoutRole>
      </bpmn:extensionElements>
    </bpmn:participant>
    <bpmn:participant id="Pool_Servicio" name="Servicio" processRef="Process_Pool_Servicio" participantWithoutLane:frequency="0">
      <bpmn:extensionElements>
        <participantWithoutLane:userWithoutRole>Sara</participantWithoutLane:userWithoutRole>
        <participantWithoutLane:userWithoutRole>Diego</participantWithoutLane:userWithoutRole>
      </bpmn:extensionElements>
    </bpmn:participant>
    <bpmn:messageFlow id="Mensaje_Peticion" name="Peticion" sourceRef="Enviar_Peticion" targetRef="Recibir_Peticion" />
    <bpmn:messageFlow id="Mensaje_Respuesta" name="Respuesta" sourceRef="Enviar_Respuesta" targetRef="Esperar_Respuesta" />
  </bpmn:collaboration>
  <bpmn:process id="Process_Pool_Cliente" isExecutable="false">
    <bpmn:startEvent id="Inicio_C" name="Arranca el cliente">
      <bpmn:outgoing>Flujo_C1</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:sendTask id="Enviar_Peticion" name="Enviar la peticion" user:NumberOfExecutions="1" user:minimumTime="10" user:maximumTime="20">
      <bpmn:extensionElements>
        <user:userTask>Carla</user:userTask>
      </bpmn:extensionElements>
      <bpmn:incoming>Flujo_C1</bpmn:incoming>
      <bpmn:outgoing>Flujo_C2</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:receiveTask id="Esperar_Respuesta" name="Esperar la respuesta" user:NumberOfExecutions="1" user:minimumTime="5" user:maximumTime="10">
      <bpmn:extensionElements>
        <user:userTask>Carla</user:userTask>
      </bpmn:extensionElements>
      <bpmn:incoming>Flujo_C2</bpmn:incoming>
      <bpmn:outgoing>Flujo_C3</bpmn:outgoing>
    </bpmn:receiveTask>
    <bpmn:endEvent id="Fin_C" name="Fin del cliente">
      <bpmn:incoming>Flujo_C3</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="Flujo_C1" sourceRef="Inicio_C" targetRef="Enviar_Peticion" />
    <bpmn:sequenceFlow id="Flujo_C2" sourceRef="Enviar_Peticion" targetRef="Esperar_Respuesta" />
    <bpmn:sequenceFlow id="Flujo_C3" sourceRef="Esperar_Respuesta" targetRef="Fin_C" />
  </bpmn:process>
  <bpmn:process id="Process_Pool_Servicio" isExecutable="false">
    <bpmn:startEvent id="Inicio_S" name="Arranca el servicio">
      <bpmn:outgoing>Flujo_S1</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:receiveTask id="Recibir_Peticion" name="Recibir la peticion" user:NumberOfExecutions="1" user:minimumTime="5" user:maximumTime="10">
      <bpmn:extensionElements>
        <user:userTask>Sara</user:userTask>
      </bpmn:extensionElements>
      <bpmn:incoming>Flujo_S1</bpmn:incoming>
      <bpmn:outgoing>Flujo_S2</bpmn:outgoing>
    </bpmn:receiveTask>
    <bpmn:task id="Atender" name="Atender la peticion" user:NumberOfExecutions="1" user:minimumTime="40" user:maximumTime="90">
      <bpmn:extensionElements>
        <user:userTask>Sara</user:userTask>
        <user:userTask>Diego</user:userTask>
      </bpmn:extensionElements>
      <bpmn:incoming>Flujo_S2</bpmn:incoming>
      <bpmn:outgoing>Flujo_S3</bpmn:outgoing>
    </bpmn:task>
    <bpmn:sendTask id="Enviar_Respuesta" name="Enviar la respuesta" user:NumberOfExecutions="1" user:minimumTime="10" user:maximumTime="20">
      <bpmn:extensionElements>
        <user:userTask>Diego</user:userTask>
      </bpmn:extensionElements>
      <bpmn:incoming>Flujo_S3</bpmn:incoming>
      <bpmn:outgoing>Flujo_S4</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:endEvent id="Fin_S" name="Fin del servicio">
      <bpmn:incoming>Flujo_S4</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="Flujo_S1" sourceRef="Inicio_S" targetRef="Recibir_Peticion" />
    <bpmn:sequenceFlow id="Flujo_S2" sourceRef="Recibir_Peticion" targetRef="Atender" />
    <bpmn:sequenceFlow id="Flujo_S3" sourceRef="Atender" targetRef="Enviar_Respuesta" />
    <bpmn:sequenceFlow id="Flujo_S4" sourceRef="Enviar_Respuesta" targetRef="Fin_S" />
  </bpmn:process>
  <bpmndi:BPMNDiagram id="BPMNDiagram_1">
    <bpmndi:BPMNPlane id="BPMNPlane_1" bpmnElement="Colaboracion">
      <bpmndi:BPMNShape id="Pool_Cliente_di" bpmnElement="Pool_Cliente" isHorizontal="true">
        <dc:Bounds x="160" y="80" width="970" height="150" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Pool_Servicio_di" bpmnElement="Pool_Servicio" isHorizontal="true">
        <dc:Bounds x="160" y="290" width="970" height="150" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Inicio_C_di" bpmnElement="Inicio_C">
        <dc:Bounds x="272" y="122" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Enviar_Peticion_di" bpmnElement="Enviar_Peticion">
        <dc:Bounds x="410" y="100" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Esperar_Respuesta_di" bpmnElement="Esperar_Respuesta">
        <dc:Bounds x="580" y="100" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Fin_C_di" bpmnElement="Fin_C">
        <dc:Bounds x="782" y="122" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Inicio_S_di" bpmnElement="Inicio_S">
        <dc:Bounds x="272" y="332" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Recibir_Peticion_di" bpmnElement="Recibir_Peticion">
        <dc:Bounds x="410" y="310" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Atender_di" bpmnElement="Atender">
        <dc:Bounds x="580" y="310" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Enviar_Respuesta_di" bpmnElement="Enviar_Respuesta">
        <dc:Bounds x="750" y="310" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Fin_S_di" bpmnElement="Fin_S">
        <dc:Bounds x="952" y="332" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="Flujo_C1_di" bpmnElement="Flujo_C1">
        <di:waypoint x="290" y="140" />
        <di:waypoint x="460" y="140" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flujo_C2_di" bpmnElement="Flujo_C2">
        <di:waypoint x="460" y="140" />
        <di:waypoint x="630" y="140" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flujo_C3_di" bpmnElement="Flujo_C3">
        <di:waypoint x="630" y="140" />
        <di:waypoint x="800" y="140" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flujo_S1_di" bpmnElement="Flujo_S1">
        <di:waypoint x="290" y="350" />
        <di:waypoint x="460" y="350" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flujo_S2_di" bpmnElement="Flujo_S2">
        <di:waypoint x="460" y="350" />
        <di:waypoint x="630" y="350" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flujo_S3_di" bpmnElement="Flujo_S3">
        <di:waypoint x="630" y="350" />
        <di:waypoint x="800" y="350" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flujo_S4_di" bpmnElement="Flujo_S4">
        <di:waypoint x="800" y="350" />
        <di:waypoint x="970" y="350" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Mensaje_Peticion_di" bpmnElement="Mensaje_Peticion">
        <di:waypoint x="460" y="140" />
        <di:waypoint x="460" y="350" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Mensaje_Respuesta_di" bpmnElement="Mensaje_Respuesta">
        <di:waypoint x="800" y="350" />
        <di:waypoint x="630" y="140" />
      </bpmndi:BPMNEdge>
    </bpmndi:BPMNPlane>
  </bpmndi:BPMNDiagram>
</bpmn:definitions>
