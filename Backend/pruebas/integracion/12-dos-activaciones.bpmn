<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:collab="http://collaboration" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:participantWithoutLane="http://participantWithoutLane" xmlns:user="http://user" id="Definitions_12_dos_activaciones" targetNamespace="http://bpmn.io/schema/bpmn" exporter="my-bpmn-exporter" exporterVersion="1.0.0">
  <bpmn:collaboration id="Colaboracion" collab:instance="1">
    <bpmn:participant id="Pool_Orquestador" name="Orquestador" processRef="Process_Pool_Orquestador" participantWithoutLane:frequency="0" participantWithoutLane:instances="1" participantWithoutLane:orchestrationRole="orchestrator" participantWithoutLane:infiniteResources="true">
      <bpmn:extensionElements>
        <participantWithoutLane:userWithoutRole>Ana</participantWithoutLane:userWithoutRole>
      </bpmn:extensionElements>
      <bpmn:participantMultiplicity />
    </bpmn:participant>
    <bpmn:participant id="Pool_Orquestado" name="Orquestado" processRef="Process_Pool_Orquestado" participantWithoutLane:frequency="10" participantWithoutLane:instances="2" participantWithoutLane:orchestrationRole="orchestrated" participantWithoutLane:infiniteResources="true">
      <bpmn:extensionElements>
        <participantWithoutLane:userWithoutRole>Beto</participantWithoutLane:userWithoutRole>
      </bpmn:extensionElements>
      <bpmn:participantMultiplicity />
    </bpmn:participant>
    <bpmn:messageFlow id="Convocatoria" name="Convocatoria" sourceRef="Convocar" targetRef="Esperar_Convocatoria" />
    <bpmn:messageFlow id="Solicitud" name="Solicitud" sourceRef="Solicitar" targetRef="Recoger" />
    <bpmn:messageFlow id="Resultado" name="Resultado" sourceRef="Responder" targetRef="Esperar_Resultado" />
  </bpmn:collaboration>
  <bpmn:process id="Process_Pool_Orquestador" isExecutable="false">
    <bpmn:startEvent id="Ini_O" name="Abre la convocatoria">
      <bpmn:outgoing>o1</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:sendTask id="Convocar" name="Publicar la convocatoria" user:NumberOfExecutions="1" user:minimumTime="1" user:maximumTime="1">
      <bpmn:extensionElements>
        <user:userTask>Ana</user:userTask>
      </bpmn:extensionElements>
      <bpmn:incoming>o1</bpmn:incoming>
      <bpmn:outgoing>o2</bpmn:outgoing>
      <bpmn:multiInstanceLoopCharacteristics />
    </bpmn:sendTask>
    <bpmn:parallelGateway id="Bifurca_O" name="Dos turnos de ventanilla">
      <bpmn:incoming>o2</bpmn:incoming>
      <bpmn:outgoing>o3</bpmn:outgoing>
      <bpmn:outgoing>o4</bpmn:outgoing>
    </bpmn:parallelGateway>
    <bpmn:task id="Ruta_A" name="Abrir el turno de la manana" user:NumberOfExecutions="1" user:minimumTime="1" user:maximumTime="1">
      <bpmn:extensionElements>
        <user:userTask>Ana</user:userTask>
      </bpmn:extensionElements>
      <bpmn:incoming>o3</bpmn:incoming>
      <bpmn:outgoing>o5</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="Ruta_B" name="Abrir el turno de la tarde" user:NumberOfExecutions="1" user:minimumTime="6" user:maximumTime="6">
      <bpmn:extensionElements>
        <user:userTask>Ana</user:userTask>
      </bpmn:extensionElements>
      <bpmn:incoming>o4</bpmn:incoming>
      <bpmn:outgoing>o6</bpmn:outgoing>
    </bpmn:task>
    <bpmn:receiveTask id="Recoger" name="Recoger una solicitud" user:NumberOfExecutions="1" user:minimumTime="1" user:maximumTime="1">
      <bpmn:extensionElements>
        <user:userTask>Ana</user:userTask>
      </bpmn:extensionElements>
      <bpmn:incoming>o5</bpmn:incoming>
      <bpmn:incoming>o6</bpmn:incoming>
      <bpmn:outgoing>o7</bpmn:outgoing>
    </bpmn:receiveTask>
    <bpmn:task id="Valorar" name="Valorar la solicitud" user:NumberOfExecutions="1" user:minimumTime="20" user:maximumTime="20">
      <bpmn:extensionElements>
        <user:userTask>Ana</user:userTask>
      </bpmn:extensionElements>
      <bpmn:incoming>o7</bpmn:incoming>
      <bpmn:outgoing>o9</bpmn:outgoing>
    </bpmn:task>
    <bpmn:sendTask id="Responder" name="Responder a la solicitud" user:NumberOfExecutions="1" user:minimumTime="1" user:maximumTime="1">
      <bpmn:extensionElements>
        <user:userTask>Ana</user:userTask>
      </bpmn:extensionElements>
      <bpmn:incoming>o9</bpmn:incoming>
      <bpmn:outgoing>o8</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:endEvent id="Fin_O" name="Cierra el turno">
      <bpmn:incoming>o8</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="o1" sourceRef="Ini_O" targetRef="Convocar" />
    <bpmn:sequenceFlow id="o2" sourceRef="Convocar" targetRef="Bifurca_O" />
    <bpmn:sequenceFlow id="o3" sourceRef="Bifurca_O" targetRef="Ruta_A" />
    <bpmn:sequenceFlow id="o4" sourceRef="Bifurca_O" targetRef="Ruta_B" />
    <bpmn:sequenceFlow id="o5" sourceRef="Ruta_A" targetRef="Recoger" />
    <bpmn:sequenceFlow id="o6" sourceRef="Ruta_B" targetRef="Recoger" />
    <bpmn:sequenceFlow id="o7" sourceRef="Recoger" targetRef="Valorar" />
    <bpmn:sequenceFlow id="o9" sourceRef="Valorar" targetRef="Responder" />
    <bpmn:sequenceFlow id="o8" sourceRef="Responder" targetRef="Fin_O" />
  </bpmn:process>
  <bpmn:process id="Process_Pool_Orquestado" isExecutable="false">
    <bpmn:startEvent id="Ini_R" name="Entra el solicitante">
      <bpmn:outgoing>r1</bpmn:outgoing>
