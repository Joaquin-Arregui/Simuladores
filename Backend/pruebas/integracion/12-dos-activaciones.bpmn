    <bpmn:sendTask id="Solicitar" name="Enviar la solicitud" user:NumberOfExecutions="1" user:minimumTime="1" user:maximumTime="1">
      <bpmn:extensionElements>
        <user:userTask>Beto</user:userTask>
      </bpmn:extensionElements>
      <bpmn:incoming>r2</bpmn:incoming>
