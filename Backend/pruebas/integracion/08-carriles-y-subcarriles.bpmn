<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:collab="http://collaboration" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:lane="http://lane" xmlns:participantWithoutLane="http://participantWithoutLane" xmlns:user="http://user" id="Definitions_08_carriles_y_subcarriles" targetNamespace="http://bpmn.io/schema/bpmn" exporter="my-bpmn-exporter" exporterVersion="1.0.0">
  <bpmn:collaboration id="Colaboracion" collab:instance="2">
    <bpmn:participant id="Pool_Cliente" name="Cliente" processRef="Process_Pool_Cliente" participantWithoutLane:frequency="50">
      <bpmn:extensionElements>
        <participantWithoutLane:userWithoutRole>Carla</participantWithoutLane:userWithoutRole>
      </bpmn:extensionElements>
    </bpmn:participant>
    <bpmn:participant id="Pool_Banco" name="Banco" processRef="Process_Pool_Banco" participantWithoutLane:frequency="0" />
    <bpmn:messageFlow id="Mensaje_Solicitud" name="Solicitud" sourceRef="Pedir_Prestamo" targetRef="Recibir_Solicitud" />
    <bpmn:messageFlow id="Mensaje_Resultado" name="Resultado" sourceRef="Enviar_Resultado" targetRef="Esperar_Resultado" />
  </bpmn:collaboration>
  <bpmn:process id="Process_Pool_Cliente" isExecutable="false">
    <bpmn:startEvent id="Inicio_C" name="Arranca el cliente">
      <bpmn:outgoing>Flujo_C1</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:sendTask id="Pedir_Prestamo" name="Pedir el prestamo" user:NumberOfExecutions="1" user:minimumTime="10" user:maximumTime="20">
      <bpmn:extensionElements>
        <user:userTask>Carla</user:userTask>
      </bpmn:extensionElements>
      <bpmn:incoming>Flujo_C1</bpmn:incoming>
      <bpmn:outgoing>Flujo_C2</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:receiveTask id="Esperar_Resultado" name="Esperar el resultado" user:NumberOfExecutions="1" user:minimumTime="5" user:maximumTime="10">
      <bpmn:extensionElements>
        <user:userTask>Carla</user:userTask>
      </bpmn:extensionElements>
      <bpmn:incoming>Flujo_C2</bpmn:incoming>
      <bpmn:outgoing>Flujo_C3</bpmn:outgoing>
    </bpmn:receiveTask>
    <bpmn:endEvent id="Fin_C" name="Fin del cliente">
      <bpmn:incoming>Flujo_C3</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="Flujo_C1" sourceRef="Inicio_C" targetRef="Pedir_Prestamo" />
    <bpmn:sequenceFlow id="Flujo_C2" sourceRef="Pedir_Prestamo" targetRef="Esperar_Resultado" />
    <bpmn:sequenceFlow id="Flujo_C3" sourceRef="Esperar_Resultado" targetRef="Fin_C" />
  </bpmn:process>
  <bpmn:process id="Process_Pool_Banco" isExecutable="false">
    <bpmn:laneSet id="LaneSet_Carril_Oficina">
      <bpmn:lane id="Carril_Oficina" name="Oficina">
        <bpmn:extensionElements>
          <lane:userWithoutRole>Ana</lane:userWithoutRole>
          <lane:userWithoutRole>Bruno</lane:userWithoutRole>
        </bpmn:extensionElements>
        <bpmn:flowNodeRef>Inicio_B</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Recibir_Solicitud</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Valorar_Riesgo</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Cobrar_Comision</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Enviar_Resultado</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Fin_B</bpmn:flowNodeRef>
        <bpmn:childLaneSet id="LaneSet_Carril_Riesgos">
          <bpmn:lane id="Carril_Riesgos" name="Riesgos">
            <bpmn:extensionElements>
              <lane:userWithoutRole>Clara</lane:userWithoutRole>
            </bpmn:extensionElements>
            <bpmn:flowNodeRef>Valorar_Riesgo</bpmn:flowNodeRef>
          </bpmn:lane>
          <bpmn:lane id="Carril_Caja" name="Caja">
            <bpmn:flowNodeRef>Cobrar_Comision</bpmn:flowNodeRef>
          </bpmn:lane>
          <bpmn:lane id="Carril_Reserva" name="Reserva">
            <bpmn:extensionElements>
              <lane:userWithoutRole>Diana</lane:userWithoutRole>
            </bpmn:extensionElements>
          </bpmn:lane>
        </bpmn:childLaneSet>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="Inicio_B" name="Arranca el banco">
      <bpmn:outgoing>Flujo_B1</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:receiveTask id="Recibir_Solicitud" name="Recibir la solicitud" user:NumberOfExecutions="1" user:minimumTime="5" user:maximumTime="10">
      <bpmn:extensionElements>
        <user:userTask>Ana</user:userTask>
        <user:userTask>Bruno</user:userTask>
      </bpmn:extensionElements>
      <bpmn:incoming>Flujo_B1</bpmn:incoming>
      <bpmn:outgoing>Flujo_B2</bpmn:outgoing>
    </bpmn:receiveTask>
    <bpmn:task id="Valorar_Riesgo" name="Valorar el riesgo" user:NumberOfExecutions="1" user:minimumTime="40" user:maximumTime="40">
      <bpmn:extensionElements>
        <user:userTask>Clara</user:userTask>
      </bpmn:extensionElements>
      <bpmn:incoming>Flujo_B2</bpmn:incoming>
      <bpmn:outgoing>Flujo_B3</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="Cobrar_Comision" name="Cobrar la comision" user:NumberOfExecutions="1" user:minimumTime="10" user:maximumTime="20">
      <bpmn:extensionElements>
        <user:userTask>Bruno</user:userTask>
      </bpmn:extensionElements>
      <bpmn:incoming>Flujo_B3</bpmn:incoming>
      <bpmn:outgoing>Flujo_B4</bpmn:outgoing>
    </bpmn:task>
    <bpmn:sendTask id="Enviar_Resultado" name="Enviar el resultado" user:NumberOfExecutions="1" user:minimumTime="10" user:maximumTime="20">
      <bpmn:extensionElements>
        <user:userTask>Ana</user:userTask>
      </bpmn:extensionElements>
      <bpmn:incoming>Flujo_B4</bpmn:incoming>
      <bpmn:outgoing>Flujo_B5</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:endEvent id="Fin_B" name="Fin del banco">
      <bpmn:incoming>Flujo_B5</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="Flujo_B1" sourceRef="Inicio_B" targetRef="Recibir_Solicitud" />
    <bpmn:sequenceFlow id="Flujo_B2" sourceRef="Recibir_Solicitud" targetRef="Valorar_Riesgo" />
    <bpmn:sequenceFlow id="Flujo_B3" sourceRef="Valorar_Riesgo" targetRef="Cobrar_Comision" />
    <bpmn:sequenceFlow id="Flujo_B4" sourceRef="Cobrar_Comision" targetRef="Enviar_Resultado" />
    <bpmn:sequenceFlow id="Flujo_B5" sourceRef="Enviar_Resultado" targetRef="Fin_B" />
  </bpmn:process>
  <bpmndi:BPMNDiagram id="BPMNDiagram_1">
    <bpmndi:BPMNPlane id="BPMNPlane_1" bpmnElement="Colaboracion">
      <bpmndi:BPMNShape id="Pool_Cliente_di" bpmnElement="Pool_Cliente" isHorizontal="true">
        <dc:Bounds x="160" y="80" width="1200" height="150" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Pool_Banco_di" bpmnElement="Pool_Banco" isHorizontal="true">
        <dc:Bounds x="160" y="290" width="1200" height="600" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Carril_Oficina_di" bpmnElement="Carril_Oficina" isHorizontal="true">
        <dc:Bounds x="190" y="290" width="1170" height="600" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Carril_Riesgos_di" bpmnElement="Carril_Riesgos" isHorizontal="true">
        <dc:Bounds x="220" y="440" width="1140" height="150" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Carril_Caja_di" bpmnElement="Carril_Caja" isHorizontal="true">
        <dc:Bounds x="220" y="590" width="1140" height="150" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Carril_Reserva_di" bpmnElement="Carril_Reserva" isHorizontal="true">
        <dc:Bounds x="220" y="740" width="1140" height="150" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Inicio_C_di" bpmnElement="Inicio_C">
        <dc:Bounds x="272" y="122" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Pedir_Prestamo_di" bpmnElement="Pedir_Prestamo">
        <dc:Bounds x="410" y="100" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Esperar_Resultado_di" bpmnElement="Esperar_Resultado">
        <dc:Bounds x="580" y="100" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Fin_C_di" bpmnElement="Fin_C">
        <dc:Bounds x="782" y="122" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Inicio_B_di" bpmnElement="Inicio_B">
        <dc:Bounds x="332" y="332" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Recibir_Solicitud_di" bpmnElement="Recibir_Solicitud">
        <dc:Bounds x="470" y="310" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Valorar_Riesgo_di" bpmnElement="Valorar_Riesgo">
        <dc:Bounds x="640" y="460" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Cobrar_Comision_di" bpmnElement="Cobrar_Comision">
        <dc:Bounds x="810" y="610" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Enviar_Resultado_di" bpmnElement="Enviar_Resultado">
        <dc:Bounds x="980" y="310" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Fin_B_di" bpmnElement="Fin_B">
        <dc:Bounds x="1182" y="332" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="Flujo_C1_di" bpmnElement="Flujo_C1">
        <di:waypoint x="290" y="140" />
        <di:waypoint x="460" y="140" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flujo_C2_di" bpmnElement="Flujo_C2">
        <di:waypoint x="460" y="140" />
        <di:waypoint x="630" y="140" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flujo_C3_di" bpmnElement="Flujo_C3">
        <di:waypoint x="630" y="140" />
        <di:waypoint x="800" y="140" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flujo_B1_di" bpmnElement="Flujo_B1">
        <di:waypoint x="350" y="350" />
        <di:waypoint x="520" y="350" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flujo_B2_di" bpmnElement="Flujo_B2">
        <di:waypoint x="520" y="350" />
        <di:waypoint x="690" y="500" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flujo_B3_di" bpmnElement="Flujo_B3">
        <di:waypoint x="690" y="500" />
        <di:waypoint x="860" y="650" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flujo_B4_di" bpmnElement="Flujo_B4">
        <di:waypoint x="860" y="650" />
        <di:waypoint x="1030" y="350" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flujo_B5_di" bpmnElement="Flujo_B5">
        <di:waypoint x="1030" y="350" />
        <di:waypoint x="1200" y="350" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Mensaje_Solicitud_di" bpmnElement="Mensaje_Solicitud">
        <di:waypoint x="460" y="140" />
        <di:waypoint x="520" y="350" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Mensaje_Resultado_di" bpmnElement="Mensaje_Resultado">
        <di:waypoint x="1030" y="350" />
        <di:waypoint x="630" y="140" />
      </bpmndi:BPMNEdge>
    </bpmndi:BPMNPlane>
  </bpmndi:BPMNDiagram>
</bpmn:definitions>
