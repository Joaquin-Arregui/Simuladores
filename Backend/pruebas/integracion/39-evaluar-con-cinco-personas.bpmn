<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:collab="http://collaboration" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:participantWithoutLane="http://participantWithoutLane" xmlns:user="http://user" id="Definitions_39_evaluar_con_cinco_personas" targetNamespace="http://bpmn.io/schema/bpmn" exporter="my-bpmn-exporter" exporterVersion="1.0.0">
  <bpmn:collaboration id="Colaboracion" name="Evaluar con cinco personas" collab:instance="1">
    <bpmn:participant id="Pool_Comision" name="Comision" processRef="Process_Pool_Comision" participantWithoutLane:frequency="0" participantWithoutLane:instances="1" participantWithoutLane:orchestrationRole="orchestrator">
      <bpmn:extensionElements>
        <participantWithoutLane:userWithoutRole>Ana</participantWithoutLane:userWithoutRole>
        <participantWithoutLane:userWithoutRole>Bea</participantWithoutLane:userWithoutRole>
        <participantWithoutLane:userWithoutRole>Carlos</participantWithoutLane:userWithoutRole>
        <participantWithoutLane:userWithoutRole>Dani</participantWithoutLane:userWithoutRole>
        <participantWithoutLane:userWithoutRole>Eva</participantWithoutLane:userWithoutRole>
        <participantWithoutLane:userWithoutRole>Gema</participantWithoutLane:userWithoutRole>
        <participantWithoutLane:userWithoutRole>Hugo</participantWithoutLane:userWithoutRole>
      </bpmn:extensionElements>
      <bpmn:participantMultiplicity />
    </bpmn:participant>
    <bpmn:participant id="Pool_Solicitante" name="Solicitante" processRef="Process_Pool_Solicitante" participantWithoutLane:frequency="3" participantWithoutLane:instances="7" participantWithoutLane:orchestrationRole="orchestrated" participantWithoutLane:infiniteResources="true">
      <bpmn:extensionElements>
        <participantWithoutLane:userWithoutRole>Solicitante</participantWithoutLane:userWithoutRole>
      </bpmn:extensionElements>
      <bpmn:participantMultiplicity />
    </bpmn:participant>
    <bpmn:messageFlow id="Convocatoria" name="Convocatoria" sourceRef="Convocar" targetRef="Esperar_Convocatoria" />
    <bpmn:messageFlow id="Solicitud" name="Solicitud" sourceRef="Solicitar" targetRef="Recoger" />
    <bpmn:messageFlow id="Resultado" name="Resultado" sourceRef="Responder" targetRef="Esperar_Resultado" />
  </bpmn:collaboration>
  <bpmn:process id="Process_Pool_Comision" isExecutable="false">
    <bpmn:startEvent id="Ini_C" name="Abre la convocatoria">
      <bpmn:outgoing>c1</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:sendTask id="Convocar" name="Publicar la convocatoria" user:NumberOfExecutions="1" user:minimumTime="1" user:maximumTime="1">
      <bpmn:extensionElements>
        <user:userTask>Gema</user:userTask>
      </bpmn:extensionElements>
      <bpmn:incoming>c1</bpmn:incoming>
      <bpmn:outgoing>c2</bpmn:outgoing>
      <bpmn:multiInstanceLoopCharacteristics />
    </bpmn:sendTask>
    <bpmn:parallelGateway id="Abre_Acta" name="Y el acta">
      <bpmn:incoming>c2</bpmn:incoming>
      <bpmn:outgoing>c3</bpmn:outgoing>
      <bpmn:outgoing>c4</bpmn:outgoing>
    </bpmn:parallelGateway>
    <bpmn:task id="Preparar_Acta" name="Preparar el acta" user:NumberOfExecutions="1" user:minimumTime="30" user:maximumTime="30">
      <bpmn:extensionElements>
        <user:userTask>Ana</user:userTask>
      </bpmn:extensionElements>
      <bpmn:incoming>c4</bpmn:incoming>
      <bpmn:outgoing>c5</bpmn:outgoing>
    </bpmn:task>
    <bpmn:endEvent id="Fin_Acta" name="Acta lista">
      <bpmn:incoming>c5</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:receiveTask id="Recoger" name="Recoger una solicitud" user:NumberOfExecutions="1" user:minimumTime="1" user:maximumTime="1">
      <bpmn:extensionElements>
        <user:userTask>Gema</user:userTask>
      </bpmn:extensionElements>
      <bpmn:incoming>c3</bpmn:incoming>
      <bpmn:outgoing>c6</bpmn:outgoing>
      <bpmn:multiInstanceLoopCharacteristics />
    </bpmn:receiveTask>
    <bpmn:task id="Evaluar" name="Evaluar una solicitud" user:NumberOfExecutions="1" user:minimumTime="20" user:maximumTime="40">
      <bpmn:extensionElements>
        <user:userTask>Ana</user:userTask>
        <user:userTask>Bea</user:userTask>
        <user:userTask>Carlos</user:userTask>
        <user:userTask>Dani</user:userTask>
        <user:userTask>Eva</user:userTask>
      </bpmn:extensionElements>
      <bpmn:incoming>c6</bpmn:incoming>
      <bpmn:outgoing>c7</bpmn:outgoing>
      <bpmn:multiInstanceLoopCharacteristics />
    </bpmn:task>
    <bpmn:sendTask id="Responder" name="Responder a una solicitud" user:NumberOfExecutions="1" user:minimumTime="1" user:maximumTime="1">
      <bpmn:extensionElements>
        <user:userTask>Gema</user:userTask>
      </bpmn:extensionElements>
      <bpmn:incoming>c7</bpmn:incoming>
      <bpmn:outgoing>c8</bpmn:outgoing>
      <bpmn:multiInstanceLoopCharacteristics />
    </bpmn:sendTask>
    <bpmn:endEvent id="Fin_C" name="Cierra la convocatoria">
      <bpmn:incoming>c8</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="c1" sourceRef="Ini_C" targetRef="Convocar" />
    <bpmn:sequenceFlow id="c2" sourceRef="Convocar" targetRef="Abre_Acta" />
    <bpmn:sequenceFlow id="c3" sourceRef="Abre_Acta" targetRef="Recoger" />
    <bpmn:sequenceFlow id="c4" sourceRef="Abre_Acta" targetRef="Preparar_Acta" />
    <bpmn:sequenceFlow id="c5" sourceRef="Preparar_Acta" targetRef="Fin_Acta" />
    <bpmn:sequenceFlow id="c6" sourceRef="Recoger" targetRef="Evaluar" />
    <bpmn:sequenceFlow id="c7" sourceRef="Evaluar" targetRef="Responder" />
    <bpmn:sequenceFlow id="c8" sourceRef="Responder" targetRef="Fin_C" />
  </bpmn:process>
  <bpmn:process id="Process_Pool_Solicitante" isExecutable="false">
    <bpmn:startEvent id="Ini_S" name="Entra el solicitante">
      <bpmn:outgoing>s1</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:receiveTask id="Esperar_Convocatoria" name="Esperar la convocatoria" user:NumberOfExecutions="1" user:minimumTime="2" user:maximumTime="2">
      <bpmn:extensionElements>
        <user:userTask>Solicitante</user:userTask>
      </bpmn:extensionElements>
      <bpmn:incoming>s1</bpmn:incoming>
      <bpmn:outgoing>s2</bpmn:outgoing>
    </bpmn:receiveTask>
    <bpmn:sendTask id="Solicitar" name="Enviar la solicitud" user:NumberOfExecutions="1" user:minimumTime="2" user:maximumTime="2">
      <bpmn:extensionElements>
        <user:userTask>Solicitante</user:userTask>
      </bpmn:extensionElements>
      <bpmn:incoming>s2</bpmn:incoming>
      <bpmn:outgoing>s3</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:receiveTask id="Esperar_Resultado" name="Esperar el resultado" user:NumberOfExecutions="1" user:minimumTime="1" user:maximumTime="1">
      <bpmn:extensionElements>
        <user:userTask>Solicitante</user:userTask>
      </bpmn:extensionElements>
      <bpmn:incoming>s3</bpmn:incoming>
      <bpmn:outgoing>s4</bpmn:outgoing>
    </bpmn:receiveTask>
    <bpmn:endEvent id="Fin_S" name="Fin del solicitante">
      <bpmn:incoming>s4</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="s1" sourceRef="Ini_S" targetRef="Esperar_Convocatoria" />
    <bpmn:sequenceFlow id="s2" sourceRef="Esperar_Convocatoria" targetRef="Solicitar" />
    <bpmn:sequenceFlow id="s3" sourceRef="Solicitar" targetRef="Esperar_Resultado" />
    <bpmn:sequenceFlow id="s4" sourceRef="Esperar_Resultado" targetRef="Fin_S" />
  </bpmn:process>
